<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_card" android:gravity="center" android:orientation="horizontal">
    <LinearLayout android:id="@+id/w_write" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:contentDescription="Write a note" android:gravity="center" android:orientation="horizontal">
        <ImageView android:layout_width="34dp" android:layout_height="34dp" android:importantForAccessibility="no" android:src="@drawable/ic_note_plus" />
    </LinearLayout>
    <ImageView android:layout_width="1dp" android:layout_height="34dp" android:background="@color/w_line" />
    <LinearLayout android:id="@+id/w_speak" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:contentDescription="Speak a note" android:gravity="center" android:orientation="horizontal">
        <ImageView android:layout_width="34dp" android:layout_height="34dp" android:importantForAccessibility="no" android:src="@drawable/ic_mic_text" />
    </LinearLayout>
</LinearLayout>
