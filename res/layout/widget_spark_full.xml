<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_card" android:orientation="vertical" android:paddingHorizontal="14dp" android:paddingVertical="10dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="4dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/w_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:textColor="@color/w_muted" android:textSize="12dp" android:text="Inbox" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/w_n1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:includeFontPadding="false" android:textColor="@color/w_ink" android:textSize="36dp" android:text="42" />
                <TextView android:id="@+id/w_caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:textColor="@color/w_sub" android:textSize="12dp" android:layout_marginStart="12dp" android:lineSpacingExtra="3dp" android:text="15 this week
19d oldest" />
            </LinearLayout>
        </LinearLayout>
        <ImageView android:id="@+id/w_chart" android:layout_width="130dp" android:layout_height="46dp" android:layout_marginEnd="2dp" android:importantForAccessibility="no" android:scaleType="fitXY" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_latest" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" android:paddingHorizontal="4dp">
        <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/w_line" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:layout_marginBottom="8dp" android:includeFontPadding="false" android:text="Latest" android:textColor="@color/w_muted" android:textSize="11dp" />
        <LinearLayout android:id="@+id/w_row1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="2dp" android:layout_height="16dp" android:background="@color/w_accent" />
            <TextView android:id="@+id/w_t1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:ellipsize="end" android:includeFontPadding="false" android:maxLines="1" android:text="Scrapling, a Python scraping framework" android:textColor="@color/w_ink" android:textSize="14dp" />
            <TextView android:id="@+id/w_m1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:includeFontPadding="false" android:text="Link · today" android:textColor="@color/w_muted" android:textSize="12dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_row2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="2dp" android:layout_height="16dp" android:background="@android:color/transparent" />
            <TextView android:id="@+id/w_t2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:ellipsize="end" android:includeFontPadding="false" android:maxLines="1" android:text="Notes from the agents talk" android:textColor="@color/w_ink" android:textSize="14dp" />
            <TextView android:id="@+id/w_m2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:includeFontPadding="false" android:text="Link · yesterday" android:textColor="@color/w_muted" android:textSize="12dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_row3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="2dp" android:layout_height="16dp" android:background="@android:color/transparent" />
            <TextView android:id="@+id/w_t3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:ellipsize="end" android:includeFontPadding="false" android:maxLines="1" android:text="Idea: voice notes into the vault" android:textColor="@color/w_ink" android:textSize="14dp" />
            <TextView android:id="@+id/w_m3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:includeFontPadding="false" android:text="Note · 2 days ago" android:textColor="@color/w_muted" android:textSize="12dp" />
        </LinearLayout>
    </LinearLayout>
    <ImageView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:id="@+id/w_actions" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:orientation="horizontal">
        <LinearLayout android:id="@+id/w_write" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="0dp" android:background="@drawable/tile_primary" android:gravity="center" android:orientation="horizontal">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:importantForAccessibility="no" android:src="@drawable/ic_pen_on_ink" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:text="Write" android:textColor="@color/w_bg" android:textSize="15dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_speak" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="8dp" android:background="@drawable/tile_raised" android:gravity="center" android:orientation="horizontal">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:importantForAccessibility="no" android:src="@drawable/ic_mic" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:text="Speak" android:textColor="@color/w_ink" android:textSize="15dp" />
        </LinearLayout>
    </LinearLayout>
    <include layout="@layout/widget_rec_strip" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" />
</LinearLayout>
